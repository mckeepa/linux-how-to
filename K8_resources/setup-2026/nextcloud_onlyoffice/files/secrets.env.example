#!/bin/sh
# Example secrets file for local user-based quadlet environment injection
# Save as: $HOME/.config/nextcloud/secrets.env
# Protect it: chmod 600 $HOME/.config/nextcloud/secrets.env

# Database
POSTGRES_PASSWORD=CHANGE_ME_postgres_password

# Nextcloud Admin
NEXTCLOUD_ADMIN_PASSWORD=CHANGE_ME_nextcloud_admin_password

# ONLYOFFICE JWT secret
JWT_SECRET=CHANGE_ME_jwt_secret
